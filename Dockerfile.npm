# syntax=docker/dockerfile:1
#
# npm-based alternative to the canonical Dockerfile.
#
# The project's package manager is Bun (see bun.lock, README.md), and the
# main Dockerfile builds with it. This file exists as a placeholder/example
# for building and running the container on a machine that only has Docker
# + npm available (e.g. a Windows dev box without Bun installed) — it does
# not replace the Bun-based image as the source of truth.
#
# No package-lock.json is committed (the project intentionally keeps a
# single lockfile, bun.lock, to avoid drift between package managers), so
# this uses `npm install` rather than `npm ci`. For a fully reproducible
# npm build, generate one locally (`npm install --package-lock-only`) and
# switch the RUN lines below to `npm ci`.
#
# Pinned to node:22-alpine rather than node:20-alpine: npm 10.8.2 (bundled
# with the node:20-alpine image at the time this was written) fails on this
# project's dependency graph with an internal arborist error
# ("Cannot read properties of null (reading 'edgesOut')") when installing
# without a lockfile; npm 10.9.x (bundled with node:22-alpine) does not have
# this problem. Node 22 still satisfies this project's `engines.node >=20`.
#
# Build:   docker build -f Dockerfile.npm -t school-backend .
# Run:     docker run --env-file .env -p 5000:5000 school-backend

FROM node:22-alpine AS base
WORKDIR /app

# --- dependencies (cached separately from source for faster rebuilds) ---
FROM base AS deps
COPY package.json ./
RUN npm install --omit=dev

# --- prisma client generation (needs dev deps + schema) ---
FROM base AS build
COPY package.json ./
RUN npm install
COPY prisma ./prisma
RUN npx prisma generate
COPY src ./src

# --- runtime image ---
FROM base AS runtime
ENV NODE_ENV=production

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY package.json ./
COPY prisma ./prisma
COPY src ./src

USER appuser

EXPOSE 5000

CMD ["node", "src/server.js"]
